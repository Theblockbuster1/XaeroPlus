{
  "schemaVersion": 1,
  "id": "xaeroplus",
  "version": "${version}",
  "name": "XaeroPlus",
  "description": "Xaero's WorldMap and MiniMap Extra Features",
  "authors": [
    "rfresh2"
  ],
  "contact": {
    "homepage": "https://github.com/rfresh2/XaeroPlus",
    "sources": "https://github.com/rfresh2/XaeroPlus"
  },
  "license": "MIT",
  "icon": "assets/xaeroplus/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "xaeroplus.fabric.XaeroPlusFabric"
    ],
    "modmenu": [
      "xaeroplus.fabric.XaeroPlusModMenu"
    ],
    "sodium:config_api_user": [
      "xaeroplus.fabric.XaeroPlusSodiumConfigBuilder"
    ]
  },
  "mixins": [
    "xaeroplus.mixins.json",
    "xaeroplus-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.1",
    "xaeroworldmap": "1.40.17"
  },
  "custom": {
    "minimap_version": "25.3.14",
    "lithium:options": {
      "mixin.chunk.palette": false
    }
  },
  "accessWidener": "xaeroplus.accesswidener"
}
